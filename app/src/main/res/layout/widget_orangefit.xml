<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkdark_gray"
    android:id="@+id/root">

    <!-- Intestazione opzionale -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginVertical="8dp">

        <TextView
            android:id="@+id/frequency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/comfortaa"
            android:textColor="@color/design_default_color_on_primary"/>

        <TextView
            android:id="@+id/phrase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" times this week"
            android:textSize="20sp"
            android:fontFamily="@font/comfortaa"/>
    </LinearLayout>

    <!-- Giorni della settimana + dot -->
    <LinearLayout
        android:id="@+id/week_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="7"
        android:layout_marginTop="12dp">

        <!-- Monday -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/monday"
                android:layout_width="44dp"
                android:layout_height="64dp"
                android:text="M"
                android:gravity="center"
                android:background="@drawable/day_oval_bg"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="6dp"
                android:layout_marginHorizontal="4dp"/>

            <LinearLayout
                android:id="@+id/dots_monday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/dot_chest_monday"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="@color/chestColor"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/dot_back_monday"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="@color/backColor"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/dot_arms_monday"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="@color/armsColor"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/dot_abs_monday"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="@color/absColor"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/dot_shoulders_monday"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="@color/shouldersColor"
                    android:visibility="gone"/>
                <FrameLayout
                    android:id="@+id/dot_legs_monday"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_margin="1dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="@color/legsColor"
                    android:visibility="gone"/>

            </LinearLayout>
        </LinearLayout>

