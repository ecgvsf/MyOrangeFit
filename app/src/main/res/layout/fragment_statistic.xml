<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.StatisticFragment"
    android:layout_marginBottom="64dp"
    android:clipChildren="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="32sp"
                android:text="Main Chart"
                android:layout_marginTop="80dp"
                android:layout_marginHorizontal="16dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.cardview.widget.CardView
                    android:id="@+id/mainChartContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:cardCornerRadius="32dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:backgroundTint="@color/darkdark_gray">

                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/composeChart"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_margin="16dp" />

                    <TextView
                        android:id="@+id/textMainChart"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_margin="16dp"
                        android:text="No Workout Done"
                        android:gravity="center"
                        android:visibility="gone"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/titleGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:text="Extra Chart"
                    android:textSize="24sp"
                    app:layout_constraintTop_toBottomOf="@+id/mainChartContainer" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/titleGrid"
                    android:layout_marginVertical="16dp"
                    android:layout_marginHorizontal="8dp"
                    android:alignmentMode="alignMargins"
                    android:rowCount="3"
                    android:columnCount="2"
                    android:clipChildren="false">

                    <com.example.myorangefit.xml.SquareFrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:layout_row="0"
                        android:layout_column="0">


                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="32dp"
                            android:backgroundTint="@color/darkdark_gray">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/title1"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Char 1"
                                    android:textSize="20sp"
                                    android:layout_marginBottom="4dp"/>


                                <androidx.compose.ui.platform.ComposeView
                                    android:id="@+id/composeChart1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </LinearLayout>


                        </androidx.cardview.widget.CardView>


                    </com.example.myorangefit.xml.SquareFrameLayout>

                    <com.example.myorangefit.xml.SquareFrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:layout_row="0"
                        android:layout_column="1">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="32dp"
                            android:backgroundTint="@color/darkdark_gray">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/title2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Char 2"
                                    android:textSize="20sp"
                                    android:layout_marginBottom="4dp"/>


                                <androidx.compose.ui.platform.ComposeView
                                    android:id="@+id/composeChart2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </com.example.myorangefit.xml.SquareFrameLayout>

                    <com.example.myorangefit.xml.SquareFrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:layout_row="1"
                        android:layout_column="0">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="32dp"
                            android:backgroundTint="@color/darkdark_gray">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/title3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Char 3"
                                    android:textSize="20sp"
                                    android:layout_marginBottom="4dp"/>


                                <androidx.compose.ui.platform.ComposeView
                                    android:id="@+id/composeChart3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </com.example.myorangefit.xml.SquareFrameLayout>

                    <com.example.myorangefit.xml.SquareFrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:layout_row="1"
                        android:layout_column="1">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="32dp"
                            android:backgroundTint="@color/darkdark_gray">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/title4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Char 4"
                                    android:textSize="20sp"
                                    android:layout_marginBottom="4dp"/>


                                <androidx.compose.ui.platform.ComposeView
                                    android:id="@+id/composeChart4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </com.example.myorangefit.xml.SquareFrameLayout>


                    <com.example.myorangefit.xml.SquareFrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:layout_row="2"
                        android:layout_column="0">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="32dp"
                            android:backgroundTint="@color/darkdark_gray">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/title5"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Char 5"
                                    android:textSize="20sp"
                                    android:layout_marginBottom="4dp"/>


                                <androidx.compose.ui.platform.ComposeView
                                    android:id="@+id/composeChart5"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </com.example.myorangefit.xml.SquareFrameLayout>

                    <com.example.myorangefit.xml.SquareFrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        android:layout_row="2"
                        android:layout_column="1">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="32dp"
                            android:backgroundTint="@color/darkdark_gray">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/title6"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Char 6"
                                    android:textSize="20sp"
                                    android:layout_marginBottom="4dp"/>


                                <androidx.compose.ui.platform.ComposeView
                                    android:id="@+id/composeChart6"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </com.example.myorangefit.xml.SquareFrameLayout>
                </GridLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

    </ScrollView>

    <!-- Fade in alto -->
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="top"
        android:background="@drawable/fade_top"
        android:clickable="false"
        android:focusable="false"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="9"
            app:cardCornerRadius="32dp"
            android:layout_marginHorizontal="16dp"
            app:cardElevation="64dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/week"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    android:text="WEEK"
                    android:textStyle="bold"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/month"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    android:text="MONTH"
                    android:textStyle="bold"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/year"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    android:text="YEAR"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:padding="8dp"/>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <com.example.myorangefit.xml.SquareFrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="32dp"
                android:backgroundTint="@color/primary">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_setting"
                    android:padding="8dp"
                    app:tint="@color/white"/>
            </androidx.cardview.widget.CardView>
        </com.example.myorangefit.xml.SquareFrameLayout>


    </LinearLayout>


    <!-- Fade in basso -->
    <View
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="-64dp"
        android:layout_gravity="bottom"
        android:background="@drawable/fade_bottom"
        android:clickable="false"
        android:focusable="false"/>

</FrameLayout>